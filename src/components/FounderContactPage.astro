---
import Base from "../layouts/Base.astro";
import { publicChannels } from "../data/founder-profile";
import { resolveLocale } from "../utils/i18n";

const locale = resolveLocale(Astro.currentLocale);
const copy = locale === "vi"
	? {
		title: "Liên hệ",
		description: "Kết nối với Nguyễn Trung Đức về sản phẩm AI, vận hành và hệ thống kỹ thuật.",
		label: "Kết nối",
		headline: "Bắt đầu bằng một vấn đề cụ thể.",
		intro:
			"Nếu bạn đang xây sản phẩm AI, đưa AI vào vận hành hoặc chuẩn hóa cách đội ngũ làm việc, hãy gửi bối cảnh và điều bạn muốn giải quyết.",
		handleLabel: "Kênh ưu tiên",
		primaryCta: "Nhắn qua Telegram",
		channelsTitle: "Tìm tôi trên các kênh này",
		channelsIntro: "Chọn nơi thuận tiện nhất. Tôi ưu tiên trao đổi có mục tiêu, bối cảnh và câu hỏi rõ ràng.",
		closingTitle: "Một tin nhắn tốt nên có gì?",
		closingBody: "Bạn đang làm gì, điểm nghẽn hiện tại và kết quả bạn muốn đạt được. Ba ý đó đủ để bắt đầu.",
		channelDescriptions: {
			GitHub: "Mã nguồn và dự án kỹ thuật",
			Facebook: "Cập nhật và trao đổi dài hơn",
			TikTok: "Ghi chú ngắn về AI và công việc",
			Telegram: "Trao đổi trực tiếp",
			YouTube: "Video và hướng dẫn thực hành",
		},
	}
	: {
		title: "Contact",
		description: "Connect with Nguyễn Trung Đức about AI products, operations, and technical systems.",
		label: "Connect",
		headline: "Start with a specific problem.",
		intro:
			"If you are building an AI product, making AI operational, or codifying how a team works, send the context and the problem you want to solve.",
		handleLabel: "Preferred channel",
		primaryCta: "Message on Telegram",
		channelsTitle: "Find me on these channels",
		channelsIntro: "Choose the channel that suits you. Clear goals, context, and questions make the best conversations.",
		closingTitle: "What makes a useful first message?",
		closingBody: "Tell me what you are building, what is blocked, and what outcome you want. Those three points are enough to begin.",
		channelDescriptions: {
			GitHub: "Source code and technical projects",
			Facebook: "Updates and longer conversations",
			TikTok: "Short notes on AI and work",
			Telegram: "Direct conversation",
			YouTube: "Videos and practical guides",
		},
	};
---

<Base
	title={copy.title}
	description={copy.description}
	localePaths={{ vi: "/contact", en: "/en/contact" }}
	bodyClass="founder-contact-page"
>
	<div class="contact-shell ui-page">
		<section class="contact-hero" aria-labelledby="contact-title">
			<div class="contact-intro">
				<p class="contact-label ui-eyebrow">{copy.label}</p>
				<h1 id="contact-title" class="ui-page-title">{copy.headline}</h1>
				<p class="contact-summary ui-lead">{copy.intro}</p>
			</div>

			<aside class="contact-direct ui-surface" aria-label={copy.handleLabel}>
				<span class="ui-eyebrow">{copy.handleLabel}</span>
				<strong class="ui-card-title">@itsddvn</strong>
				<a class="ui-button" href="https://t.me/itsddvn" target="_blank" rel="me noopener noreferrer">
					{copy.primaryCta}<i aria-hidden="true">↗</i>
				</a>
			</aside>
		</section>

		<section class="contact-channels" aria-labelledby="channels-title">
			<header>
				<h2 id="channels-title" class="ui-section-title">{copy.channelsTitle}</h2>
				<p class="ui-body">{copy.channelsIntro}</p>
			</header>

			<nav aria-label={copy.channelsTitle}>
				{
					publicChannels.map((channel, index) => (
						<a href={channel.href} target="_blank" rel="me noopener noreferrer">
							<span>{String(index + 1).padStart(2, "0")}</span>
							<strong class="ui-card-title">{channel.label}</strong>
							<p class="ui-body">{copy.channelDescriptions[channel.label]}</p>
							<i aria-hidden="true">↗</i>
						</a>
					))
				}
			</nav>
		</section>

		<section class="contact-brief ui-surface" aria-labelledby="brief-title">
			<h2 id="brief-title" class="ui-section-title">{copy.closingTitle}</h2>
			<p class="ui-body">{copy.closingBody}</p>
		</section>
	</div>
</Base>

<style>
	:global(body.founder-contact-page) {
		background: var(--color-bg);
	}


	.contact-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.55fr);
		gap: var(--spacing-16);
		align-items: end;
		padding-bottom: var(--spacing-20);
		border-bottom: 1px solid var(--color-border);
	}

	.contact-intro {
		max-width: 52rem;
	}

	.contact-label,
	.contact-direct > span {
		margin-bottom: var(--spacing-6);
	}

	.contact-intro h1 {
		max-width: 12ch;
	}

	.contact-summary {
		margin-top: var(--spacing-8);
	}

	.contact-direct {
		display: flex;
		min-height: 17rem;
		padding: var(--spacing-8);
		flex-direction: column;
		justify-content: space-between;
	}


	.contact-direct a {
		justify-content: space-between;
	}

	.contact-direct a:hover {
		transform: translateY(-2px);
	}

	.contact-direct a:active {
		transform: translateY(1px);
	}


	.contact-channels {
		display: grid;
		grid-template-columns: minmax(15rem, 0.7fr) minmax(0, 1.3fr);
		gap: var(--spacing-16);
		padding: var(--spacing-20) 0;
	}

	.contact-channels > header {
		align-self: start;
	}


	.contact-channels > header p,
	.contact-brief p {
		max-width: 45ch;
		margin-top: var(--spacing-6);
	}

	.contact-channels nav {
		border-top: 1px solid var(--color-border);
	}

	.contact-channels a {
		display: grid;
		min-height: 6rem;
		padding: var(--spacing-6) var(--spacing-4);
		border-bottom: 1px solid var(--color-border);
		grid-template-columns: 3rem minmax(8rem, 0.65fr) minmax(0, 1.35fr) auto;
		gap: var(--spacing-4);
		align-items: center;
		color: var(--color-text);
		text-decoration: none;
		transition:
			transform var(--transition-fast),
			color var(--transition-base),
			background-color var(--transition-base);
	}

	.contact-channels a > span {
		color: var(--color-muted);
		font-size: var(--type-label-size);
		font-variant-numeric: tabular-nums;
	}


	.contact-channels a > p {
		margin: 0;
	}

	.contact-channels a:hover {
		background: var(--color-surface);
		color: var(--color-brand);
		transform: translateX(var(--spacing-1));
	}

	.contact-channels a:active {
		transform: translateX(var(--spacing-1)) translateY(1px);
	}

	.contact-brief {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: var(--spacing-16);
		padding: var(--spacing-16);
	}

	.contact-brief p {
		align-self: end;
	}

	@media (max-width: 800px) {

		.contact-hero,
		.contact-channels,
		.contact-brief {
			grid-template-columns: 1fr;
		}

		.contact-hero,
		.contact-channels {
			gap: var(--spacing-10);
		}


		.contact-direct {
			min-height: 14rem;
		}

		.contact-channels {
			padding: var(--spacing-16) 0;
		}

		.contact-channels a {
			grid-template-columns: 2rem 1fr auto;
		}

		.contact-channels a > p {
			grid-column: 2 / -1;
		}

		.contact-brief {
			gap: var(--spacing-6);
			padding: var(--spacing-8);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-direct a,
		.contact-channels a {
			transition: none;
		}

		.contact-direct a:hover,
		.contact-direct a:active {
			transform: none;
		}
	}
</style>
