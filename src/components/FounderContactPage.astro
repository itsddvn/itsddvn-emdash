---
import Base from "../layouts/Base.astro";
import PlatformMark from "./PlatformMark.astro";
import { contactEmail, getFounderProfile, publicChannels } from "../data/founder-profile";
import { resolveLocale } from "../utils/i18n";
import "../styles/founder-home.css";
import "../styles/founder-contact.css";

const locale = resolveLocale(Astro.currentLocale);
const profile = getFounderProfile(locale);
const telegram = publicChannels.find((channel) => channel.label === "Telegram")!;
const followChannels = publicChannels.filter((channel) => channel.label !== "Telegram");
const [featuredSystem, ...otherSystems] = profile.work.systems;

const copy =
	locale === "vi"
		? {
				title: "Liên hệ",
				description:
					"Liên hệ Nguyễn Trung Đức về sản phẩm AI, vận hành agent và chuẩn hóa đội ngũ. Telegram và email là hai kênh trực tiếp.",
				label: "Kết nối",
				headline: "Liên hệ khi có việc cụ thể.",
				intro: "Tôi là Nguyễn Trung Đức, CEO CPPAI. Nhắn khi bạn đang xây sản phẩm AI, đưa agent vào vận hành, hoặc chuẩn hóa cách đội ngũ làm việc.",
				telegramCta: "Nhắn Telegram",
				emailCta: "Gửi email",
				directNote: "Giờ Việt Nam, GMT+7. Trả lời khi đủ bối cảnh để bắt đầu.",
				briefItems: [
					"Bạn đang làm gì, với ai.",
					"Điểm nghẽn hiện tại.",
					"Kết quả muốn đạt được.",
				],
				channelsTitle: "Kênh công khai",
				channelsIntro: "Theo dõi công việc đang làm. Việc cụ thể gửi Telegram hoặc email.",
				workTitle: "Việc đang làm",
				workIntro: "Ba hệ thống đang vận hành. Mở nếu đó là lý do bạn viết.",
				channelDescriptions: {
					GitHub: "Mã nguồn, issue kỹ thuật, dự án mở.",
					Facebook: "Cập nhật dài và trao đổi công khai.",
					TikTok: "Ghi chú ngắn về AI và cách làm.",
					YouTube: "Video và hướng dẫn thực hành.",
				},
			}
		: {
				title: "Contact",
				description:
					"Contact Nguyễn Trung Đức about AI products, agent operations, and how teams work. Telegram and email are the direct channels.",
				label: "Connect",
				headline: "Write when you have a specific problem.",
				intro: "I am Nguyễn Trung Đức, CEO of CPPAI. Message me if you are building an AI product, putting agents into operations, or codifying how a team works.",
				telegramCta: "Message Telegram",
				emailCta: "Send email",
				directNote: "Vietnam time, GMT+7. I reply when there is enough context to start.",
				briefItems: [
					"What you are building, and with whom.",
					"What is blocked right now.",
					"The outcome you want.",
				],
				channelsTitle: "Public channels",
				channelsIntro: "Follow the work in public. Specific work goes to Telegram or email.",
				workTitle: "Work in public",
				workIntro: "Three systems currently in operation. Open one if that is why you are writing.",
				channelDescriptions: {
					GitHub: "Source, technical issues, public projects.",
					Facebook: "Longer updates and public conversation.",
					TikTok: "Short notes on AI and working methods.",
					YouTube: "Videos and practical walkthroughs.",
				},
			};
---

<Base
	title={copy.title}
	description={copy.description}
	localePaths={{ vi: "/contact", en: "/en/contact" }}
	bodyClass="founder-home founder-contact-page"
>
	<div class="founder-shell">
		<section class="founder-panel contact-hero" aria-labelledby="contact-title">
			<div class="contact-hero-copy">
				<p class="founder-kicker">{copy.label}</p>
				<h1 id="contact-title">{copy.headline}</h1>
				<p>{copy.intro}</p>
				<ol class="contact-brief">
					{
						copy.briefItems.map((item, index) => (
							<li>
								<b>{String(index + 1).padStart(2, "0")}</b>
								{item}
							</li>
						))
					}
				</ol>
			</div>

			<div class="contact-direct">
				<a class="is-primary" href={telegram.href} target="_blank" rel="me noopener noreferrer">
					<PlatformMark name="telegram" />
					<span>
						<strong>{copy.telegramCta}</strong>
						<code>{telegram.handle}</code>
					</span>
					<i aria-hidden="true">↗</i>
				</a>
				<a href={contactEmail.href}>
					<PlatformMark name="email" />
					<span>
						<strong>{copy.emailCta}</strong>
						<code>
							{contactEmail.handle.split("@")[0]}
							<span>@</span>
							{contactEmail.handle.split("@")[1]}
						</code>
					</span>
					<i aria-hidden="true">↗</i>
				</a>
				<p class="contact-note">{copy.directNote}</p>
			</div>
		</section>


		<section class="founder-panel contact-channels" aria-labelledby="channels-title">
			<header class="founder-section-head">
				<h2 id="channels-title">{copy.channelsTitle}</h2>
				<p>{copy.channelsIntro}</p>
			</header>
			<nav class="contact-directory" aria-label={copy.channelsTitle}>
				{
					followChannels.map((channel) => (
						<a href={channel.href} target="_blank" rel="me noopener noreferrer">
							<PlatformMark name={channel.icon} />
							<span>
								<strong>
									{channel.label}
									<i aria-hidden="true">↗</i>
								</strong>
								<code>{channel.handle}</code>
								<p>{copy.channelDescriptions[channel.label]}</p>
							</span>
						</a>
					))
				}
			</nav>
		</section>

		<section class="founder-panel contact-work" aria-labelledby="work-title">
			<header class="founder-section-head">
				<h2 id="work-title">{copy.workTitle}</h2>
				<p>{copy.workIntro}</p>
			</header>
			<div class="contact-work-grid">
				<a href={featuredSystem.href} target="_blank" rel="noopener noreferrer">
					<span>{featuredSystem.mode}</span>
					<strong>{featuredSystem.title}</strong>
					<p>{featuredSystem.description}</p>
				</a>
				{
					otherSystems.map((system) => (
						<a href={system.href} target="_blank" rel="noopener noreferrer">
							<span>{system.mode}</span>
							<strong>{system.title}</strong>
							<p>{system.description}</p>
						</a>
					))
				}
			</div>
		</section>
	</div>
</Base>
