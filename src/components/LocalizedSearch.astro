---
import { getMessages, localePath, resolveLocale } from "../utils/i18n";

interface Props {
	collections?: string[];
}

const { collections = ["posts", "pages"] } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const copy = getMessages(locale);
const searchPage = localePath(locale, "/search");
const localePrefix = locale === "en" ? "/en" : "";
---

<form
	class="site-search localized-search"
	method="get"
	action={searchPage}
	role="search"
	data-localized-search
	data-locale={locale}
	data-prefix={localePrefix}
	data-collections={collections.join(",")}
	data-no-results={copy.noSearchResults}
>
	<label class="sr-only" for={`site-search-${locale}`}>{copy.search}</label>
	<input
		id={`site-search-${locale}`}
		type="search"
		name="q"
		placeholder={copy.searchPlaceholder}
		class="site-search-input ui-input"
		autocomplete="off"
		aria-autocomplete="list"
		aria-controls={`site-search-results-${locale}`}
	/>
	<div
		id={`site-search-results-${locale}`}
		class="site-search-results"
		role="listbox"
		hidden
	></div>
</form>

<script>
	interface SearchResult {
		collection: string;
		id: string;
		slug: string | null;
		title?: string;
		excerpt?: string;
		snippet?: string;
	}

	const SEARCH_DELAY_MS = 300;
	const MIN_QUERY_LENGTH = 2;

	for (const form of document.querySelectorAll<HTMLFormElement>("[data-localized-search]")) {
		const input = form.querySelector<HTMLInputElement>("input[type='search']");
		const results = form.querySelector<HTMLDivElement>("[role='listbox']");
		if (!input || !results) continue;

		let debounceTimer: number | undefined;
		let abortController: AbortController | undefined;
		let activeIndex = -1;

		const hideResults = () => {
			results.hidden = true;
			results.replaceChildren();
			activeIndex = -1;
			input.removeAttribute("aria-activedescendant");
		};

		const setActiveResult = (index: number) => {
			const links = [...results.querySelectorAll<HTMLAnchorElement>("a")];
			if (links.length === 0) return;
			activeIndex = (index + links.length) % links.length;
			for (const [linkIndex, link] of links.entries()) {
				link.classList.toggle("focused", linkIndex === activeIndex);
			}
			const activeLink = links[activeIndex];
			input.setAttribute("aria-activedescendant", activeLink.id);
			activeLink.scrollIntoView({ block: "nearest" });
		};

		const resultHref = (result: SearchResult) => {
			const prefix = form.dataset.prefix ?? "";
			const locale = form.dataset.locale ?? "";
			const collection = result.collection === "pages" ? "pages" : "posts";
			const rawIdentifier = result.slug ?? result.id;
			const localePrefix = `${locale}/`;
			const identifier = rawIdentifier.startsWith(localePrefix)
				? rawIdentifier.slice(localePrefix.length)
				: rawIdentifier;
			return `${prefix}/${collection}/${encodeURIComponent(identifier)}`;
		};

		const renderResults = (items: SearchResult[]) => {
			results.replaceChildren();
			activeIndex = -1;

			if (items.length === 0) {
				const empty = document.createElement("p");
				empty.className = "emdash-live-search-no-results";
				empty.textContent = form.dataset.noResults ?? "No results";
				results.append(empty);
				results.hidden = false;
				return;
			}

			for (const [index, item] of items.entries()) {
				const link = document.createElement("a");
				link.id = `site-search-result-${index}`;
				link.className = "site-search-result";
				link.href = resultHref(item);
				link.role = "option";

				const title = document.createElement("span");
				title.className = "emdash-live-search-result-title";
				title.textContent = item.title || item.slug || item.id;
				link.append(title);

				const snippetText = item.snippet || item.excerpt;
				if (snippetText) {
					const snippet = document.createElement("span");
					snippet.className = "emdash-live-search-result-snippet";
					snippet.textContent = snippetText;
					link.append(snippet);
				}

				results.append(link);
			}

			results.hidden = false;
		};

		const runSearch = async (query: string) => {
			abortController?.abort();
			abortController = new AbortController();
			const params = new URLSearchParams({
				q: query,
				locale: form.dataset.locale ?? "vi",
				collections: form.dataset.collections ?? "posts,pages",
				limit: "8",
			});

			try {
				const response = await fetch(`/_emdash/api/search?${params}`, {
					signal: abortController.signal,
				});
				if (!response.ok) throw new Error(`Search failed with ${response.status}`);
				const payload = await response.json();
				renderResults(payload.data?.items ?? payload.items ?? []);
			} catch (error) {
				if ((error as Error).name !== "AbortError") hideResults();
			}
		};

		input.addEventListener("input", () => {
			window.clearTimeout(debounceTimer);
			const query = input.value.trim();
			if (query.length < MIN_QUERY_LENGTH) {
				abortController?.abort();
				abortController = undefined;
				hideResults();
				return;
			}
			debounceTimer = window.setTimeout(() => void runSearch(query), SEARCH_DELAY_MS);
		});

		input.addEventListener("keydown", (event) => {
			if (results.hidden) return;
			if (event.key === "ArrowDown") {
				event.preventDefault();
				setActiveResult(activeIndex + 1);
			} else if (event.key === "ArrowUp") {
				event.preventDefault();
				setActiveResult(activeIndex < 0 ? results.querySelectorAll("a").length - 1 : activeIndex - 1);
			} else if (event.key === "Enter" && activeIndex >= 0) {
				event.preventDefault();
				results.querySelectorAll<HTMLAnchorElement>("a")[activeIndex]?.click();
			} else if (event.key === "Escape") {
				hideResults();
			}
		});

		document.addEventListener("click", (event) => {
			if (!form.contains(event.target as Node)) hideResults();
		});
	}
</script>

<style>
	.site-search {
		position: relative;
		width: var(--search-input-width);
	}


	.site-search-input::placeholder {
		color: var(--color-muted);
	}


	.site-search-results {
		position: absolute;
		top: calc(100% + 8px);
		right: 0;
		left: 0;
		z-index: 40;
		max-height: min(420px, 70vh);
		overflow-y: auto;
		padding: 8px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	:global(.site-search-result) {
		display: grid;
		gap: 4px;
		min-height: 44px;
		padding: 10px 12px;
		border-radius: calc(var(--radius) - 2px);
		color: var(--color-text);
		font-size: var(--type-meta-size);
		line-height: var(--leading-snug);
		text-decoration: none;
	}

	:global(.site-search-result:hover),
	:global(.site-search-result:focus),
	:global(.site-search-result.focused) {
		background: var(--color-bg-subtle);
		color: var(--color-brand);
	}

	:global(.emdash-live-search-result-title) {
		font-weight: 700;
	}

	:global(.emdash-live-search-result-snippet) {
		display: -webkit-box;
		overflow: hidden;
		color: var(--color-muted);
		font-size: var(--type-label-size);
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	:global(.emdash-live-search-no-results) {
		margin: 0;
		padding: 12px;
		color: var(--color-muted);
		font-size: var(--type-meta-size);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
