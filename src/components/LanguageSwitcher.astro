---
import {
	SUPPORTED_LOCALES,
	getMessages,
	getRouteLocalePaths,
	resolveLocale,
	type SiteLocale,
} from "../utils/i18n";

interface Props {
	paths?: Partial<Record<SiteLocale, string>>;
}

const { paths } = Astro.props;
const currentLocale = resolveLocale(Astro.currentLocale);
const copy = getMessages(currentLocale);
const fallbackPaths = getRouteLocalePaths(Astro.url.pathname);
const links = SUPPORTED_LOCALES.map((locale) => ({
	locale,
	href: paths?.[locale] ?? `${fallbackPaths[locale]}${Astro.url.search}`,
}));
---

<nav class="language-switcher" aria-label={copy.languageLabel}>
	{
		links.map(({ locale, href }) => (
			<a
				href={href}
				lang={locale}
				hreflang={locale}
				aria-current={locale === currentLocale ? "page" : undefined}
			>
				{locale.toUpperCase()}
			</a>
		))
	}
</nav>

<style>
	.language-switcher {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
	}

	a {
		position: relative;
		min-width: var(--control-height);
		min-height: var(--control-height);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0 6px;
		border-radius: var(--radius);
		color: var(--color-muted);
		font-size: var(--type-label-size);
		font-weight: 500;
		letter-spacing: 0.08em;
		text-decoration: none;
		transition:
			color var(--transition-fast),
			background-color var(--transition-base);
	}

	a + a::before {
		position: absolute;
		left: calc(var(--spacing-1) * -1);
		color: var(--color-border);
		content: "/";
	}

	a:hover,
	a:focus-visible {
		color: var(--color-text);
	}

	a[aria-current="page"] {
		background: var(--color-brand-soft);
		color: var(--color-brand);
		font-weight: 600;
	}
</style>
