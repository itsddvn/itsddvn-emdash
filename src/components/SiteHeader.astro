---
import { Image } from "astro:assets";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import LocalizedSearch from "./LocalizedSearch.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { getFounderProfile } from "../data/founder-profile";
import logoDark from "../assets/brand/itsdd-mascot-logo-on-dark.png";
import logoLight from "../assets/brand/itsdd-mascot-logo.png";
import { localePath, type SiteLocale } from "../utils/i18n";

interface Props {
	locale: SiteLocale;
	localePaths?: Partial<Record<SiteLocale, string>>;
	menuItems: Array<{ label: string; url: string; target?: string | null }>;
	isLoggedIn?: boolean;
}

const { locale, localePaths, menuItems, isLoggedIn = false } = Astro.props;
const profile = getFounderProfile(locale);
const homeHref = localePath(locale, "/");
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const navPath = (url: string) => {
	try {
		return new URL(url, Astro.url).pathname.replace(/\/$/, "") || "/";
	} catch {
		return url.replace(/\/$/, "") || "/";
	}
};
const isCurrentNav = (url: string) => {
	const path = navPath(url);
	if (path === "/" || path === "/en") return currentPath === path;
	return currentPath === path || currentPath.startsWith(`${path}/`);
};
---

<header class="site-header founder-header">
	<div class="header-inner">
		<a class="site-title founder-brand" href={homeHref} aria-label="itsdd.vn">
			<Image
				class="brand-logo brand-logo--dark"
				src={logoDark}
				alt=""
				widths={[150, 300]}
				sizes="150px"
				loading="eager"
				fetchpriority="high"
			/>
			<Image
				class="brand-logo brand-logo--light"
				src={logoLight}
				alt=""
				widths={[150, 300]}
				sizes="150px"
				loading="eager"
			/>
		</a>

		<nav class="primary-nav" id="primary-nav" aria-label={profile.navigation.menu}>
			{
				menuItems.map((item) => (
					<a
						href={item.url}
						target={item.target}
						rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
						aria-current={isCurrentNav(item.url) ? "page" : undefined}
					>
						{item.label}
					</a>
				))
			}
			<div class="nav-search">
				<LocalizedSearch collections={["posts", "pages"]} />
			</div>
		</nav>

		<div class="header-tools">
			{
				isLoggedIn && (
					<a class="admin-link" href="/_emdash/admin">
						{locale === "vi" ? "Quản trị" : "Admin"}
					</a>
				)
			}
			<ThemeToggle locale={locale} />
			<div class="language-slot">
				<LanguageSwitcher paths={localePaths} />
			</div>
			<button
				class="menu-toggle"
				type="button"
				aria-expanded="false"
				aria-controls="primary-nav"
			>
				{profile.navigation.menu}
			</button>
		</div>
	</div>
</header>

<script>
	const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
	const primaryNav = document.querySelector<HTMLElement>(".primary-nav");

	menuToggle?.addEventListener("click", () => {
		const open = primaryNav?.classList.toggle("is-open") ?? false;
		menuToggle.setAttribute("aria-expanded", String(open));
	});

	primaryNav?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => {
			primaryNav.classList.remove("is-open");
			menuToggle?.setAttribute("aria-expanded", "false");
		});
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 8px;
		z-index: 20;
		width: min(calc(100% - 32px), 1320px);
		margin: 16px auto 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-header);
		box-shadow: var(--shadow-sm);
		backdrop-filter: blur(var(--surface-blur));
	}

	.header-inner {
		min-height: var(--nav-height);
		display: flex;
		align-items: center;
		gap: 24px;
		padding: 0 20px;
	}

	.site-title {
		min-height: var(--control-height);
		display: inline-flex;
		align-items: center;
		color: var(--color-text);
		font-family: var(--font-heading);
		font-size: var(--type-body-size);
		font-weight: 700;
		letter-spacing: -0.02em;
		text-decoration: none;
	}

	.site-title :global(img) {
		width: 150px;
		height: auto;
		display: block;
	}

	.site-title :global(.brand-logo--light) {
		display: none;
	}

	:global(html[data-theme="light"]) .site-title :global(.brand-logo--dark) {
		display: none;
	}

	:global(html[data-theme="light"]) .site-title :global(.brand-logo--light) {
		display: block;
	}

	:global(html[data-theme="dark"]) .site-title :global(.brand-logo--dark) {
		display: block;
	}

	:global(html[data-theme="dark"]) .site-title :global(.brand-logo--light) {
		display: none;
	}

	.primary-nav {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-inline: auto;
	}

	.primary-nav > a {
		position: relative;
		min-height: var(--control-height);
		display: inline-flex;
		align-items: center;
		padding: 0 10px;
		border-radius: var(--radius);
		color: var(--color-text-secondary);
		font-size: var(--type-meta-size);
		font-weight: 400;
		text-decoration: none;
	}

	.primary-nav a:hover,
	.primary-nav a:focus-visible {
		color: var(--color-text);
		background: var(--color-surface-hover);
	}

	.primary-nav a[aria-current="page"] {
		background: var(--color-brand-soft);
		color: var(--color-brand);
		font-weight: 600;
	}

	.primary-nav a[aria-current="page"]::before {
		position: absolute;
		top: 8px;
		bottom: 8px;
		left: 0;
		width: 3px;
		border-radius: 2px;
		background: var(--color-action);
		content: "";
	}


	.nav-search {
		width: 180px;
	}

	.nav-search :global(.site-search) {
		width: 100%;
	}

	.header-tools {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.admin-link {
		min-height: var(--control-height);
		display: inline-flex;
		align-items: center;
		color: var(--color-text-secondary);
		font-size: var(--type-meta-size);
		font-weight: 500;
		text-decoration: none;
	}

	.admin-link:hover,
	.admin-link:focus-visible {
		color: var(--color-text);
	}

	.menu-toggle {
		min-height: var(--control-height-touch);
		display: none;
		padding: 0 16px;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
		color: var(--color-text);
		font: 600 var(--type-body-size) / 1 var(--font-body);
		cursor: pointer;
	}

	@media (prefers-color-scheme: light) {
		:global(html:not([data-theme])) .site-title :global(.brand-logo--dark) {
			display: none;
		}

		:global(html:not([data-theme])) .site-title :global(.brand-logo--light) {
			display: block;
		}
	}

	@media (max-width: 860px) {
		.site-header {
			width: calc(100% - 16px);
			margin-top: 8px;
		}

		.header-inner {
			position: relative;
			flex-wrap: wrap;
			padding: 10px 16px;
		}

		.primary-nav {
			order: 3;
			width: 100%;
			display: none;
			align-items: stretch;
			gap: 0;
			padding-top: 8px;
			border-top: 1px solid var(--color-border-subtle);
		}

		.primary-nav.is-open {
			display: grid;
		}

		:global(.no-js) .primary-nav {
			display: grid;
		}

		:global(.no-js) .menu-toggle {
			display: none;
		}

		.primary-nav > a {
			width: 100%;
			min-height: var(--control-height-touch);
			padding-inline: 12px;
			border-bottom: 1px solid var(--color-border-subtle);
		}

		.nav-search {
			width: 100%;
			padding: 8px;
		}

		.header-tools {
			margin-inline-start: auto;
		}

		.menu-toggle {
			display: inline-flex;
			align-items: center;
		}
	}

	@media (max-width: 520px) {
		.header-inner {
			gap: 8px;
		}
	}
</style>
