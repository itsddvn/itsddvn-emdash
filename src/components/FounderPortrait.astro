---
import { Image } from "astro:assets";
import portrait from "../assets/founder/nguyen-trung-duc-portrait.jpg";

interface Props {
	alt: string;
	strengthsLabel: string;
}

const { alt, strengthsLabel } = Astro.props;
const strengths = [
	{ className: "strength-water", label: "Nước nói", value: "100%" },
	{ className: "strength-executive", label: "Executive", value: "70%" },
	{ className: "strength-research", label: "Research", value: "60%" },
	{ className: "strength-networking", label: "Networking", value: "80%" },
	{ className: "strength-builds", label: "Builds", value: "70%" },
	{ className: "strength-sale", label: "Sale", value: "50%" },
];
---

<div class="founder-portrait">
	<svg class="portrait-radar" viewBox="0 0 440 440" aria-hidden="true">
		<g class="radar-grid">
			<polygon points="220,30 384.5,125 384.5,315 220,410 55.5,315 55.5,125" />
			<polygon points="220,65 354.2,142.5 354.2,297.5 220,375 85.8,297.5 85.8,142.5" />
			<polygon points="220,100 323.9,160 323.9,280 220,340 116.1,280 116.1,160" />
			<path d="M220 220V30M220 220L384.5 125M220 220L384.5 315M220 220V410M220 220L55.5 315M220 220L55.5 125" />
		</g>
		<polygon class="radar-data" points="220,30 359.9,139.3 351.6,296 220,391 80.1,300.8 96.6,148.8" />
		<g class="radar-points">
			<circle cx="220" cy="30" r="7" />
			<circle cx="359.9" cy="139.3" r="5.5" />
			<circle cx="351.6" cy="296" r="5" />
			<circle cx="220" cy="391" r="6" />
			<circle cx="80.1" cy="300.8" r="5.5" />
			<circle cx="96.6" cy="148.8" r="4.5" />
		</g>
	</svg>

	<figure class="portrait-facet">
		<Image
			src={portrait}
			alt={alt}
			widths={[220, 440]}
			sizes="(max-width: 600px) 180px, 220px"
			loading="eager"
			fetchpriority="high"
		/>
	</figure>

	<ul class="portrait-strengths" aria-label={strengthsLabel}>
		{strengths.map((strength) => (
			<li class={strength.className}>
				<span>{strength.label}</span><strong>{strength.value}</strong>
			</li>
		))}
	</ul>
</div>

<style>
	.founder-portrait {
		position: relative;
		min-height: 440px;
		display: grid;
		place-items: center;
		overflow: hidden;
	}

	.portrait-radar {
		position: absolute;
		z-index: 1;
		width: min(100%, 440px);
		aspect-ratio: 1;
		overflow: visible;
	}

	.radar-grid {
		fill: none;
		stroke: var(--color-border);
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}

	.radar-grid polygon:nth-child(2) {
		opacity: 0.72;
	}

	.radar-grid polygon:nth-child(3) {
		opacity: 0.45;
	}

	.radar-grid path {
		opacity: 0.7;
	}

	.radar-data {
		fill: color-mix(in oklch, var(--color-action) 12%, transparent);
		stroke: var(--color-action);
		stroke-width: 2;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}

	.radar-points circle {
		fill: var(--color-bg);
		stroke: var(--color-action);
		stroke-width: 2;
		vector-effect: non-scaling-stroke;
	}

	.portrait-facet {
		position: relative;
		z-index: 2;
		width: min(58%, 220px);
		aspect-ratio: 13 / 15;
		overflow: hidden;
		clip-path: polygon(50% 0, 93.3% 25%, 93.3% 75%, 50% 100%, 6.7% 75%, 6.7% 25%);
		border: 1px solid var(--color-action);
		background: var(--color-bg-subtle);
	}

	.portrait-facet :global(img) {
		position: absolute;
		inset: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 38%;
		filter: saturate(0.82) contrast(1.05);
	}

	.portrait-strengths {
		position: absolute;
		inset: 0;
		z-index: 4;
		margin: 0;
		padding: 0;
		list-style: none;
		pointer-events: none;
	}

	.portrait-strengths li {
		position: absolute;
		min-height: 28px;
		display: inline-flex;
		align-items: center;
		gap: 7px;
		padding: 3px 9px;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-bg);
		color: var(--color-text-secondary);
		font: 500 var(--type-micro-size) / 1 var(--font-heading);
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.portrait-strengths strong {
		color: var(--color-brand);
		font: 600 0.9em / 1 var(--font-heading);
		letter-spacing: 0;
	}

	.portrait-strengths li::before {
		width: 5px;
		aspect-ratio: 1;
		border-radius: 50%;
		background: var(--color-action);
		content: "";
	}

	.portrait-strengths .strength-water {
		left: 50%;
		top: 5%;
		padding: 5px 11px;
		transform: translate(-50%, -50%) rotate(-3deg);
		border-color: var(--color-action);
		background: var(--color-brand-soft);
		color: var(--color-brand);
		font-size: var(--type-label-size);
		font-weight: 600;
	}

	.portrait-strengths .strength-water::before {
		background: var(--color-action);
	}

	.portrait-strengths .strength-water strong {
		color: var(--color-brand);
	}

	.portrait-strengths .strength-water::after {
		position: absolute;
		inset: -5px;
		border: 1px solid var(--color-action);
		border-radius: 999px;
		animation: water-ring 2.8s var(--ease-out-quart) infinite;
		content: "";
	}


	.portrait-strengths .strength-networking {
		border-color: color-mix(in oklch, var(--color-brand) 55%, var(--color-border));
		background: color-mix(in oklch, var(--color-brand) 7%, var(--color-bg));
		font-size: var(--type-micro-size);
	}

	.strength-executive {
		left: 86%;
		top: 24%;
		transform: translate(-50%, -50%) rotate(6deg);
	}

	.strength-research {
		left: 84%;
		top: 72%;
		transform: translate(-50%, -50%) rotate(7deg);
	}

	.strength-networking {
		left: 50%;
		top: 95%;
		transform: translate(-50%, -50%) rotate(3deg);
	}

	.strength-builds {
		left: 16%;
		top: 72%;
		transform: translate(-50%, -50%) rotate(-6deg);
	}

	.portrait-strengths .strength-sale {
		left: 21%;
		top: 27%;
		min-height: 26px;
		padding: 3px 8px;
		transform: translate(-50%, -50%) rotate(-4deg);
		color: var(--color-muted);
		font-size: var(--type-micro-size);
	}

	@keyframes water-ring {
		0%,
		55%,
		100% {
			opacity: 0;
			transform: scale(0.94);
		}
		70% {
			opacity: 0.55;
			transform: scale(1.08);
		}
	}

	@media (max-width: 980px) {
		.founder-portrait {
			min-height: 400px;
		}
	}

	@media (max-width: 600px) {
		.founder-portrait {
			min-height: 340px;
		}
		.portrait-strengths .strength-water {
			top: 8%;
		}
		.strength-networking {
			top: 94%;
		}
		.strength-executive {
			left: 81%;
		}
		.strength-research {
			left: 80%;
		}
		.strength-builds {
			left: 20%;
		}
		.strength-sale {
			left: 22%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.portrait-strengths .strength-water::after {
			animation: none;
		}
	}
</style>
