---
import {
	getTerm,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";
import { entrySlugForLocale, getMessages, getTaxonomyLocalePaths, localePath, resolveLocale } from "../../utils/i18n";

const locale = resolveLocale(Astro.currentLocale);
const copy = getMessages(locale);
const slug = decodeSlug(Astro.params.slug);
const term = slug ? await getTerm("category", slug, { locale }) : null;

if (!term) {
	return Astro.redirect(localePath(locale, "/404"));
}
const termLocale = resolveLocale(term.locale);
const localePaths = await getTaxonomyLocalePaths("category", term, "category");

if (termLocale !== locale) {
	return Astro.redirect(
		localePaths[termLocale] ?? localePath(termLocale, `/category/${term.slug}`),
	);
}
const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	locale: termLocale,
	where: { category: term.slug },
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags on every post in this category, rather
// than calling getEntryTerms() per post (which would be one round-trip
// per post).
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
	{ locale: termLocale },
);
const filteredPosts = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base
	title={copy.categoryPosts(term.label)}
	description={copy.categoryDescription(term.label)}
	localePaths={localePaths}
>
	<section class="ui-page">
		<header class="ui-page-header">
			<span class="ui-eyebrow">{copy.categories}</span>
			<h1 class="ui-page-title">{term.label}</h1>
			<p class="ui-meta">{copy.articleCount(filteredPosts.length)}</p>
		</header>

		{
			filteredPosts.length === 0 ? (
				<p class="ui-empty">{copy.noCategoryPosts}</p>
			) : (
				<div class="ui-card-grid">
					{filteredPosts.map(({ post, tags }) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={localePath(locale, `/posts/${entrySlugForLocale(post.id, locale)}`)}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
							locale={locale}
						/>
					))}
				</div>
			)
		}
	</section>
</Base>
