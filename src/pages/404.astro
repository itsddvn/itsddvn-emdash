---
import Base from "../layouts/Base.astro";
import { getMessages, localePath, resolveLocale } from "../utils/i18n";

const locale = resolveLocale(Astro.currentLocale);
const copy = getMessages(locale);
---

<Base title={copy.pageNotFound}>
	<div class="ui-page ui-page--reading ui-empty-state">
		<h1 class="ui-display">404</h1>
		<p class="ui-lead">{copy.pageNotFoundBody}</p>
		<a class="ui-button ui-button--secondary" href={localePath(locale, "/")}>{copy.returnHome}</a>
	</div>
</Base>
