---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../layouts/Base.astro";
import FounderPortrait from "../components/FounderPortrait.astro";
import { getFounderProfile, publicChannels } from "../data/founder-profile";
import { getReadingTime } from "../utils/reading-time";
import { entrySlugForLocale, localePath, resolveLocale } from "../utils/i18n";
import operatingMap from "../assets/founder/operating-system-map.svg";
import myAgentsMapVi from "../assets/founder/myagents-system-map.svg";
import myAgentsMapEn from "../assets/founder/myagents-system-map-en.svg";
import "../styles/founder-home.css";

const locale = resolveLocale(Astro.currentLocale);
const profile = getFounderProfile(locale);
const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	locale,
	orderBy: { published_at: "desc" },
	limit: 3,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const categoriesByEntry = await getTermsForEntries(
	"posts",
	posts.map((post) => post.data.id),
	"category",
	{ locale },
);
const recentPosts = posts.map((post) => ({
	post,
	category: categoriesByEntry.get(post.data.id)?.[0]?.label ?? profile.writing.label,
	readingTime: getReadingTime(post.data.content),
}));
const featuredPost = recentPosts[0];
const secondaryPosts = recentPosts.slice(1, 3);
const myAgentsMap = locale === "en" ? myAgentsMapEn : myAgentsMapVi;

const formatDate = (date: Date | null | undefined) =>
	date?.toLocaleDateString(locale === "vi" ? "vi-VN" : "en-US", {
		day: "2-digit",
		month: "2-digit",
		year: "numeric",
	});
---

<Base
	title={profile.metaTitle}
	description={profile.metaDescription}
	bodyClass="founder-home"
>
	<div class="founder-shell">
		<section class="founder-hero founder-panel" id="identity">
			<FounderPortrait
				alt={profile.hero.portraitAlt}
				strengthsLabel={profile.hero.strengthsLabel}
			/>
			<div class="founder-hero-copy">
				<p class="founder-kicker">{profile.hero.kicker}</p>
				<h1>
					<span class="headline-line">{profile.hero.lineOne}</span>
					<span class="headline-line">
						{profile.hero.lineTwoPrefix} <strong>{profile.hero.lineTwoHighlight}</strong>
					</span>
				</h1>
				<p>{profile.hero.summary}</p>
				<div class="founder-actions">
					<a class="ui-button" href="#systems">{profile.hero.workCta}</a>
					<a class="ui-button ui-button--secondary" href="#articles">{profile.hero.articlesCta}</a>
				</div>
			</div>
		</section>

		<section class="operating-showcase founder-panel" id="practice" aria-labelledby="practice-title">
			<figure class="illustration-frame">
				<img
					src={operatingMap.src}
					alt={profile.method.imageAlt}
					width="720"
					height="480"
					loading="lazy"
					decoding="async"
				/>
			</figure>
			<div class="operating-copy">
				<span class="founder-section-label">{profile.method.label}</span>
				<h2 id="practice-title">{profile.method.title}</h2>
				<ol class="operating-steps">
					{
						profile.method.steps.map((step, index) => (
							<li>
								<span>{String(index + 1).padStart(2, "0")}</span>
								<div>
									<h3>{step.title}</h3>
									<p>{step.description}</p>
								</div>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section class="systems-section founder-panel" id="systems" aria-labelledby="systems-title">
			<header class="founder-section-head">
				<span class="founder-section-label">{profile.work.label}</span>
				<h2 id="systems-title">{profile.work.title}</h2>
			</header>
			<div class="systems-layout">
				{
					profile.work.systems.map((system) =>
						system.featured ? (
							<a
								class="system-feature"
								href={system.href}
								target="_blank"
								rel="noopener noreferrer"
							>
								<figure class="system-visual">
									<img
										src={myAgentsMap.src}
										alt={locale === "vi" ? "Sơ đồ hệ sinh thái MyAgents" : "MyAgents ecosystem diagram"}
										width="720"
										height="480"
										loading="lazy"
										decoding="async"
									/>
								</figure>
								<div class="system-feature-copy">
									<span>{system.mode}</span>
									<h3>{system.title}</h3>
									<p>{system.description}</p>
									<b>{profile.work.storyCta}</b>
								</div>
							</a>
						) : null,
					)
				}
				<div class="system-stack">
					{
						profile.work.systems
							.filter((system) => !system.featured)
							.map((system) => (
								<a
									class="system-card"
									href={system.href}
									target="_blank"
									rel="noopener noreferrer"
								>
									<span>{system.mode}</span>
									<h3>{system.title}</h3>
									<p>{system.description}</p>
									<i aria-hidden="true">↗</i>
								</a>
							))
					}
				</div>
			</div>
		</section>

		<section class="founder-writing founder-panel" id="articles" aria-labelledby="articles-title">
			<header>
				<div>
					<span class="founder-section-label">{profile.writing.label}</span>
					<h2 id="articles-title">{profile.writing.title}</h2>
				</div>
				<a href={localePath(locale, "/posts")}>{profile.writing.viewAll}</a>
			</header>
			{
				featuredPost ? (
					<div class="writing-layout">
						<a class="writing-feature" href={localePath(locale, `/posts/${entrySlugForLocale(featuredPost.post.id, locale)}`)}>
							<span>{featuredPost.category}</span>
							<h3>{featuredPost.post.data.title || profile.writing.untitled}</h3>
							<footer>
								<time datetime={featuredPost.post.data.publishedAt?.toISOString()}>
									{formatDate(featuredPost.post.data.publishedAt)}
								</time>
								<b>{featuredPost.readingTime} {locale === "vi" ? "phút đọc" : "min read"}</b>
							</footer>
						</a>
						<div class="writing-rail">
							{secondaryPosts.map(({ post, category }) => (
								<a href={localePath(locale, `/posts/${entrySlugForLocale(post.id, locale)}`)}>
									<span>{category}</span>
									<h3>{post.data.title || profile.writing.untitled}</h3>
									<i aria-hidden="true">↗</i>
								</a>
							))}
						</div>
					</div>
				) : (
					<p class="founder-writing-empty">
						{locale === "vi" ? "Chưa có bài viết được xuất bản." : "No published articles yet."}
					</p>
				)
			}
		</section>

		<section class="founder-contact founder-panel">
			<div>
				<span class="founder-section-label">{profile.contact.label}</span>
				<h2><span class="nowrap">{profile.contact.handle}</span></h2>
			</div>
			<nav aria-label={profile.contact.navigationLabel}>
				{
					publicChannels.map((channel) => (
						<a class="ui-button ui-button--secondary" href={channel.href} target="_blank" rel="me noopener noreferrer">
							{channel.label}
						</a>
					))
				}
			</nav>
		</section>
	</div>

	<script>
		const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
		const founderPanels = document.querySelectorAll<HTMLElement>(".founder-panel");

		if (!reducedMotion.matches && "IntersectionObserver" in window) {
			founderPanels.forEach((panel) => panel.classList.add("reveal-ready"));
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (!entry.isIntersecting) return;
						entry.target.classList.add("is-visible");
						observer.unobserve(entry.target);
					});
				},
				{ rootMargin: "-8% 0px -12%", threshold: 0.12 },
			);
			founderPanels.forEach((panel) => observer.observe(panel));
		}

		document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
			link.addEventListener("click", (event) => {
				const href = link.getAttribute("href");
				const target = href ? document.querySelector<HTMLElement>(href) : null;
				if (!target) return;
				event.preventDefault();
				target.scrollIntoView({
					behavior: reducedMotion.matches ? "auto" : "smooth",
					block: "start",
				});
			});
		});
	</script>
</Base>
