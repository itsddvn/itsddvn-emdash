---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import { getReadingTime } from "../../utils/reading-time";
import { entrySlugForLocale, getMessages, localePath, resolveLocale } from "../../utils/i18n";

const locale = resolveLocale(Astro.currentLocale);
const copy = getMessages(locale);
// Sort in the database rather than in JS — lets the DB use its index on
// published_at and avoids a full-table scan on the client.
const { entries: posts, cacheHint } = await getEmDashCollection("posts", {
	locale,
	orderBy: { published_at: "desc" },
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags across all posts, instead of one
// getEntryTerms() call per post (which would be N round-trips).
// Bylines are already hydrated on entry.data.bylines.
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
	{ locale },
);

const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
	bylines: post.data.bylines ?? [],
}));

const formatDate = (date: Date) =>
	date.toLocaleDateString(locale === "vi" ? "vi-VN" : "en-US", {
		year: "numeric",
		month: "long",
		day: "numeric",
	});
---

<Base title={copy.allPosts} description={copy.searchDescription}>
	<div class="posts-page ui-page">
		<header class="page-header ui-page-header">
			<h1 class="page-title ui-page-title">{copy.allPosts}</h1>
			<p class="page-description ui-meta">{copy.articleCount(posts.length)}</p>
		</header>

		{
			posts.length === 0 ? (
				<p class="empty ui-empty">{copy.noPosts}</p>
			) : (
				<div class="posts-list">
					{postsWithTags.map(({ post, tags, bylines }) => (
						<article class="post-item">
							<a href={localePath(locale, `/posts/${entrySlugForLocale(post.id, locale)}`)} class="post-link">
								<div class="post-meta ui-meta">
									{bylines.length > 0 && (
										<>
											<div class="post-bylines">
												{bylines.slice(0, 2).map((credit, index) => (
													<>
														{index > 0 && <span class="byline-sep">,</span>}
														<span class="post-byline">
															{credit.byline.avatarMediaId && (
																<img
																	src={`/_emdash/api/media/file/${credit.byline.avatarMediaId}`}
																	alt={credit.byline.displayName}
																	class="post-byline-avatar"
																/>
															)}
															<span class="post-byline-name">
																{credit.byline.displayName}
															</span>
														</span>
													</>
												))}
												{bylines.length > 2 && (
													<span class="byline-more">+{bylines.length - 2}</span>
												)}
											</div>
											<span class="meta-dot" />
										</>
									)}
									{post.data.publishedAt && (
										<time>{formatDate(post.data.publishedAt)}</time>
									)}
									{post.data.publishedAt && <span class="meta-dot" />}
									<span>{copy.minuteRead(getReadingTime(post.data.content))}</span>
								</div>
								<h2 class="post-title ui-card-title">{post.data.title}</h2>
								{post.data.excerpt && (
									<p class="post-excerpt ui-lead">{post.data.excerpt}</p>
								)}
							</a>
							{tags.length > 0 && (
								<div class="post-tags">
									{tags.slice(0, 3).map((t) => (
										<a href={localePath(locale, `/tag/${t.slug}`)} class="post-tag">
											{t.label}
										</a>
									))}
								</div>
							)}
						</article>
					))}
				</div>
			)
		}
	</div>
</Base>

<style>

	.posts-list {
		border-top: 1px solid var(--color-border);
	}

	.post-item {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 176px;
		gap: var(--spacing-12);
		padding: var(--spacing-10) 0;
		border-bottom: 1px solid var(--color-border);
	}

	.post-link {
		display: grid;
		grid-template-columns: var(--meta-col-width) minmax(0, 1fr);
		column-gap: var(--spacing-12);
		color: inherit;
		text-decoration: none;
	}

	.post-meta {
		grid-row: 1 / span 2;
		grid-column: 1;
		display: flex;
		align-items: flex-start;
		flex-direction: column;
		gap: var(--spacing-2);
	}

	.post-meta .meta-dot {
		display: none;
	}

	.post-bylines {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--spacing-1);
	}

	.post-byline {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
	}

	.post-byline-avatar {
		width: var(--avatar-size-sm);
		height: var(--avatar-size-sm);
		border-radius: 50%;
		object-fit: cover;
	}

	.post-byline-name {
		color: var(--color-text-secondary);
		font-weight: 600;
	}

	.byline-sep,
	.byline-more {
		color: var(--color-muted);
		font-size: var(--type-label-size);
	}

	.post-title {
		grid-column: 2;
		max-width: 22ch;
		margin-bottom: var(--spacing-3);
		transition:
			color var(--transition-fast),
			transform var(--transition-fast);
	}

	.post-excerpt {
		grid-column: 2;
		max-width: 58ch;
	}

	.post-link:hover .post-title,
	.post-link:focus-visible .post-title {
		color: var(--color-brand);
		transform: translateX(var(--spacing-1));
	}

	.post-tags {
		display: flex;
		align-content: flex-start;
		flex-wrap: wrap;
		gap: var(--spacing-2) var(--spacing-3);
	}

	.post-tag {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		min-width: 44px;
		color: var(--color-text-secondary);
		font-size: var(--type-label-size);
		font-weight: 500;
		text-decoration-color: var(--color-border);
		text-decoration-line: underline;
		text-underline-offset: 4px;
		transition:
			color var(--transition-fast),
			text-decoration-color var(--transition-fast),
			transform var(--transition-fast);
	}

	.post-tag:hover,
	.post-tag:focus-visible {
		color: var(--color-brand);
		text-decoration-color: currentColor;
		transform: translateY(-2px);
	}

	@media (max-width: 900px) {

		.post-item {
			grid-template-columns: 1fr;
			gap: var(--spacing-4);
		}

		.post-link {
			grid-template-columns: 144px minmax(0, 1fr);
			column-gap: var(--spacing-8);
		}

		.post-title,
		.post-excerpt {
			grid-column: 2;
		}
	}


	@media (max-width: 600px) {
		.post-item {
			padding: var(--spacing-8) 0;
		}

		.post-link {
			grid-template-columns: 1fr;
		}

		.post-meta {
			grid-row: auto;
			grid-column: 1;
			align-items: center;
			flex-direction: row;
			flex-wrap: wrap;
			margin-bottom: var(--spacing-3);
		}

		.post-title,
		.post-excerpt {
			grid-column: 1;
		}

	}
</style>
