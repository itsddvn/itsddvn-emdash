---
export const prerender = false;

import { search } from "emdash";
import Base from "../layouts/Base.astro";
import { entrySlugForLocale, getMessages, localePath, resolveLocale } from "../utils/i18n";

const locale = resolveLocale(Astro.currentLocale);
const copy = getMessages(locale);
const query = Astro.url.searchParams.get("q")?.trim() || "";

// Use the FTS-backed search() API instead of loading every post and
// filtering in JS. FTS scales as the post count grows, returns ranked
// results, and handles tokenization/stemming. Templates that grep all
// post bodies in JS quickly become unusable past a few hundred posts.
const { items: results } = query
	? await search(query, { collections: ["posts"], locale, limit: 30 })
	: { items: [] };
---

<Base
	title={query ? `${copy.search}: ${query}` : copy.search}
	description={copy.searchDescription}
>
	<section class="search-page ui-page ui-page--reading">
		<h1 class="search-title ui-page-title">{copy.search}</h1>

		<form method="get" action={localePath(locale, "/search")} class="search-form ui-form-row">
			<label class="sr-only" for="site-search-query">{copy.search}</label>
			<input
				id="site-search-query"
				type="search"
				name="q"
				value={query}
				placeholder={copy.searchPlaceholder}
				class="ui-input"
				autofocus
			/>
			<button type="submit" class="ui-button">{copy.searchButton}</button>
		</form>

		{
			query && (
				<p class="search-summary ui-meta">{copy.searchSummary(results.length, query)}</p>
			)
		}

		{
			results.length > 0 && (
				<ol class="search-results">
					{results.map((result) => (
						<li class="search-result">
							<a
								href={localePath(locale, `/posts/${entrySlugForLocale(result.slug ?? result.id, locale)}`)}
								class="result-link"
							>
								<h2 class="result-title ui-card-title">
									{result.title ?? copy.untitled}
								</h2>
								{result.snippet && (
									<p class="result-snippet ui-body" set:html={result.snippet} />
								)}
							</a>
						</li>
					))}
				</ol>
			)
		}

		{!query && <p class="search-hint ui-body">{copy.searchHint}</p>}
	</section>
</Base>

<style>

	.search-form {
		margin: var(--spacing-6) 0 var(--spacing-8);
	}


	.search-summary {
		margin-bottom: var(--spacing-6);
	}

	.search-results {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
	}

	.search-result {
		padding: var(--spacing-6) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.search-result:first-child {
		padding-top: 0;
	}

	.search-result:last-child {
		border-bottom: none;
	}

	.result-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}


	.result-link:hover .result-title {
		color: var(--color-brand);
	}

	.result-snippet {
		max-width: var(--measure-body);
	}

	/* FTS returns <mark> wrapping the matched terms */
	.result-snippet :global(mark) {
		background: var(--color-brand-ring);
		color: inherit;
		padding: 0 0.1em;
		border-radius: 2px;
	}
</style>
