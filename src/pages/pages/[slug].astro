---
import { getEmDashEntry, decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { getMessages, resolveLocale } from "../../utils/i18n";

const locale = resolveLocale(Astro.currentLocale);
const copy = getMessages(locale);
const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect(locale === "en" ? "/en/404" : "/404");
}

const { entry: page, cacheHint, fallbackLocale } = await getEmDashEntry("pages", slug, { locale });

if (!page) {
	return Astro.redirect(locale === "en" ? "/en/404" : "/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base
	title={page.data.title}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article class="ui-page ui-page--reading">
		<header class="ui-page-header">
			<h1 class="ui-page-title" {...page.edit.title}>{page.data.title}</h1>
		</header>
		{fallbackLocale && <p class="fallback-notice">{copy.fallbackNotice}</p>}

		<div class="ui-prose">
			<PortableText value={page.data.content} />
		</div>
	</article>
</Base>
