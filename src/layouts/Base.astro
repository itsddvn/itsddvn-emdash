---
import { getMenu, getSiteSettings } from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import SiteHeader from "../components/SiteHeader.astro";
import favicon from "../assets/brand/itsdd-favicon.png";
import { getFounderProfile } from "../data/founder-profile";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import {
	SUPPORTED_LOCALES,
	getContentLocalePaths,
	getRouteLocalePaths,
	localePath,
	resolveLocale,
	type SiteLocale,
} from "../utils/i18n";
import "../styles/tokens.css";
import "../styles/theme.css";
import "../styles/system.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	localePaths?: Partial<Record<SiteLocale, string>>;
	bodyClass?: string;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
	localePaths,
	bodyClass,
} = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const profile = getFounderProfile(locale);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const fullTitle = title.includes(siteTitle) ? title : `${title} | ${siteTitle}`;
const primaryMenu = await getMenu("primary", { locale });
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.url.origin).toString();
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical: canonicalUrl,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});
const switcherPaths =
	localePaths ??
	(content ? await getContentLocalePaths(content, Astro.url.pathname) : undefined);
const alternatePaths = switcherPaths ?? getRouteLocalePaths(Astro.url.pathname);
const alternates = SUPPORTED_LOCALES.flatMap((alternateLocale) => {
	const path = alternatePaths[alternateLocale];
	return path
		? [{ locale: alternateLocale, href: new URL(path, Astro.url.origin).toString() }]
		: [];
});
const xDefaultHref = alternatePaths.vi
	? new URL(alternatePaths.vi, Astro.url.origin).toString()
	: alternates[0]?.href;
const isLoggedIn = Boolean(Astro.locals.user);
const currentYear = new Date().getFullYear();
const contactHref = localePath(locale, "/contact");
const menuItems = (primaryMenu?.items ?? []).map((item) => ({
	label: item.label,
	url: item.url,
	target: item.target,
}));
const hasContact = menuItems.some((item) => {
	try {
		const path = new URL(item.url, Astro.url).pathname.replace(/\/$/, "") || "/";
		return path === contactHref || path.endsWith("/contact");
	} catch {
		return item.url.includes("/contact");
	}
});
if (!hasContact) {
	menuItems.push({
		label: profile.navigation.contact,
		url: contactHref,
		target: undefined,
	});
}
---

<!doctype html>
<html class="no-js" lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<script is:inline>
			document.documentElement.classList.replace("no-js", "js");
			try {
				const theme = localStorage.getItem("itsdd-theme");
				if (theme === "light" || theme === "dark") {
					document.documentElement.dataset.theme = theme;
				}
			} catch {}
		</script>
		<link rel="icon" type="image/png" href={favicon.src} />
		<Font cssVariable="--font-body" preload />
		<Font cssVariable="--font-mono" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		{
			alternates.map((alternate) => (
				<link rel="alternate" hreflang={alternate.locale} href={alternate.href} />
			))
		}
		{xDefaultHref && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${profile.navigation.articles} RSS`}
			href={localePath(locale, "/rss.xml").replace(/\/$/, "")}
		/>

	</head>
	<body class={bodyClass}>
		<EmDashBodyStart page={pageCtx} />
		<SiteHeader
			locale={locale}
			localePaths={switcherPaths}
			menuItems={menuItems}
			isLoggedIn={isLoggedIn}
		/>

		<main>
			<slot />
		</main>

		<footer class="site-footer founder-footer">
			<a href={localePath(locale, "/")}>© {currentYear} Nguyễn Trung Đức</a>
			<span>{profile.footerLine}</span>
		</footer>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
